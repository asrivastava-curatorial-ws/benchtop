{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Benchtop",
  "version": "../package.json",
  "identifier": "app.benchtop.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Offline developer tools",
    "longDescription": "Benchtop gathers 130 developer utilities (formatters, converters, query and validation tools, encoders, hashes and keys, network and DevOps helpers, generators, CSS and image tools, and a Bootstrap theme builder) in one desktop app that never connects to the internet.",
    "copyright": "Copyright (c) 2026 Abhisht Srivastava. MIT licence.",
    "licenseFile": "../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": {
        "section": "devel"
      },
      "rpm": {
        "release": "1"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "publisher": "Benchtop"
  }
}
