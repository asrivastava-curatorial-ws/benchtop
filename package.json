{
  "name": "benchtop",
  "private": true,
  "version": "1.0.0",
  "description": "Benchtop - a fully offline, open-source desktop toolbox of developer utilities",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "biome check . && node scripts/check-source-chars.mjs",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:desktop": "node tests/desktop/run.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:e2e",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@lezer/highlight": "^1.2.5",
    "@noble/hashes": "^2.4.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.9",
    "bwip-js": "^4.11.4",
    "codemirror": "^6.0.2",
    "cron-parser": "^5.10.5",
    "cronstrue": "^3.39.0",
    "css-tree": "^3.2.1",
    "csso": "^5.0.5",
    "culori": "^4.0.2",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "he": "^2.0.0",
    "htmlparser2": "^12.0.0",
    "js-beautify": "^2.0.3",
    "marked": "^18.2.0",
    "papaparse": "^5.7.1",
    "preact": "^11.2.0",
    "prettier": "^3.10.1",
    "random-words": "^2.0.1",
    "sass": "1.108.2",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "terser": "^5.51.2",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "uuid": "^14.0.3",
    "xml-formatter": "^3.7.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@tauri-apps/cli": "^2.12.4",
    "@types/css-tree": "^3.2.0",
    "@types/csso": "^5.0.5",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/selenium-webdriver": "^4.35.7",
    "@types/turndown": "^5.0.6",
    "selenium-webdriver": "^4.52.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "author": "Abhisht Srivastava",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher"
    ]
  }
}
