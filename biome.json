{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": false
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!src-tauri/target",
      "!src-tauri/gen",
      "!test-results",
      "!playwright-report",
      "!**/*.min.css",
      "!docs/TOOLS.md",
      "!public/tesseract",
      "!src/recipe/vendor",
      "!tests/e2e/fixtures/cyberchef-port-cases.json",
      "!tests/unit/fixtures/cyberchef-extra-cases.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 200
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "error",
        "useTemplate": "off",
        "noDescendingSpecificity": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "a11y": {
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "noNoninteractiveElementInteractions": "off",
        "useSemanticElements": "off",
        "noNoninteractiveElementToInteractiveRole": "off"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "correctness": {
        "usePlaywrightValidDescribeCallback": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
